{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3Warden",
  "version": "0.1.0",
  "identifier": "dev.s3warden.app",
  "build": {
    "beforeDevCommand": "pnpm -C web dev",
    "beforeBuildCommand": "pnpm -C web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "S3Warden",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
